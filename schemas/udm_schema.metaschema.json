{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-insight.github.io/AI4RA-UDM/schemas/udm_schema.metaschema.json",
  "title": "UDM schema artifact metaschema",
  "description": "Structural contract for udm_schema.json. Everything specified is a module; a rule lives on the thing it governs: constraints on their table, derivation rules and synonyms on their column, module conventions and example views on their module. Referential rules (foreign keys resolve, primary-key naming, the module laws) are enforced by scripts/validate_schema.py and cannot be expressed in JSON Schema.",
  "type": "object",
  "required": ["metadata", "types", "conventions", "modules", "implementation_tables"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["name", "version", "released"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "released": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "description": { "type": "string" },
        "spec_source": { "type": "string" },
        "changelog": { "type": "string" }
      }
    },
    "types": {
      "type": "object",
      "required": ["abstract", "dialects"],
      "properties": {
        "abstract": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "description": { "type": "string" },
        "dialects": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "conventions": {
      "type": "object",
      "required": [
        "identifier", "hierarchy", "role_named_foreign_keys", "polymorphic_attachment",
        "lifecycle_stage", "two_fk_exclusive_or", "allowed_values", "boolean_naming",
        "audit_columns", "audit_authority", "is_active_vs_status", "constraint_vocabulary",
        "value_normalization", "lifecycle_closure", "semantic"
      ],
      "properties": {
        "audit_columns": {
          "type": "object",
          "required": ["description", "columns"],
          "properties": {
            "description": { "type": "string" },
            "columns": { "type": "object", "additionalProperties": { "$ref": "#/$defs/column" } }
          }
        },
        "semantic": { "type": "array", "items": { "$ref": "#/$defs/convention" } }
      }
    },
    "modules": {
      "type": "object",
      "required": ["description", "laws", "core", "optional"],
      "properties": {
        "description": { "type": "string" },
        "laws": {
          "type": "object",
          "required": ["capability_criterion", "encapsulation_rule"],
          "properties": {
            "capability_criterion": { "type": "string" },
            "encapsulation_rule": { "type": "string" }
          }
        },
        "core": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/core_module" }
        },
        "optional": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/optional_module" }
        }
      }
    },
    "implementation_tables": {
      "type": "object",
      "required": ["description", "tables"],
      "properties": {
        "description": { "type": "string" },
        "tables": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/table" } }
      }
    }
  },
  "$defs": {
    "core_module": {
      "type": "object",
      "required": ["name", "story", "tables"],
      "properties": {
        "name": { "type": "string" },
        "story": { "type": "string" },
        "tables": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/table" } },
        "conventions": { "type": "array", "items": { "$ref": "#/$defs/convention" } },
        "example_views": { "type": "array", "items": { "$ref": "#/$defs/view" } }
      }
    },
    "optional_module": {
      "type": "object",
      "required": ["name", "story", "requires", "records_targets", "allowed_value_groups", "tables"],
      "properties": {
        "name": { "type": "string" },
        "story": { "type": "string" },
        "requires": {
          "type": "object",
          "required": ["core", "modules"],
          "properties": {
            "core": { "type": "string" },
            "modules": { "type": "array", "items": { "type": "string" } }
          }
        },
        "records_targets": { "type": "array", "items": { "type": "string" } },
        "allowed_value_groups": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "tables": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/table" } },
        "conventions": { "type": "array", "items": { "$ref": "#/$defs/convention" } },
        "example_views": { "type": "array", "items": { "$ref": "#/$defs/view" } }
      }
    },
    "table": {
      "type": "object",
      "required": ["description", "columns"],
      "properties": {
        "description": { "type": "string" },
        "columns": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/column" } },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
        "notes": {}
      }
    },
    "column": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "required": { "type": "boolean" },
        "primary_key": { "type": "boolean" },
        "description": { "type": "string" },
        "pii": { "type": "boolean" },
        "synonyms": { "type": "string" },
        "value_group": { "type": "string" },
        "recommended_values": { "type": "array", "items": { "type": "string" } },
        "allowed_values": { "type": "array", "items": { "type": "string" } },
        "value_definitions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["definition"],
            "properties": {
              "definition": { "type": "string" },
              "set_by": { "type": "string" },
              "next": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "conditional_required": { "type": "string" },
        "references": {
          "type": "object",
          "required": ["table", "column"],
          "properties": {
            "table": { "type": "string" },
            "column": { "type": "string" }
          }
        },
        "derived": {
          "type": "object",
          "required": ["rule", "recompute_triggers"],
          "properties": {
            "rule": { "type": "string" },
            "recompute_triggers": { "type": "string" }
          }
        }
      }
    },
    "constraint": {
      "type": "object",
      "required": ["rule"],
      "properties": {
        "rule": { "type": "string" },
        "structured": { "type": "object" }
      }
    },
    "convention": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string" } }
    },
    "view": {
      "type": "object",
      "required": ["name", "purpose", "sql"],
      "properties": {
        "name": { "type": "string" },
        "purpose": { "type": "string" },
        "dialect": { "type": "string" },
        "sql": { "type": "string" }
      }
    }
  }
}
